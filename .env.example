# Copy to .env before running. This agent runs on a machine on the OFFICE
# LAN (same network as the ESSL K30 device) — NOT on the VPS.

# The device's LAN IP and port (default eSSL K30 port is 4370).
ESSL_DEVICE_IP=192.168.1.201
ESSL_DEVICE_PORT=4370

# Full URL of the backend's ingest endpoint, reachable over the internet.
VPS_INGEST_URL=https://ironmart.co.in/api/v1/attendance/device-logs/ingest

# Must match the backend's DEVICE_AGENT_TOKEN env var exactly.
DEVICE_AGENT_TOKEN=change-this-to-a-long-random-string

# How often to poll the device, in minutes.
POLL_INTERVAL_MINUTES=5
