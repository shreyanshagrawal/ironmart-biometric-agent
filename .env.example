# Copy to .env before running. This agent runs on a machine on the OFFICE
# LAN (same network as the ESSL K30 device) — NOT on the VPS.

# The device's LAN IP and port — used ONLY for device-user enrollment
# (ZK TCP write direction: setUser / deleteUser). Punch sync now uses the
# ADMS push protocol (device calls this agent), not ZK TCP pull.
ESSL_DEVICE_IP=192.168.1.201
ESSL_DEVICE_PORT=4370

# Port this agent's ADMS HTTP server listens on.
# On the device: Menu → Comm. → Cloud Server Settings
#   Server Mode: ADMS
#   Enable Domain Name: OFF
#   Server Address: <this machine's LAN IP>:<ADMS_PORT>   e.g. 192.168.1.50:7788
#   Enable Proxy Server: OFF
# The Windows Firewall must allow inbound TCP on this port.
ADMS_PORT=7788

# Full URL of the backend's ingest endpoint, reachable over the internet.
VPS_INGEST_URL=https://ironmart.co.in/api/v1/attendance/device-logs/ingest

# Must match the backend's DEVICE_AGENT_TOKEN env var exactly.
DEVICE_AGENT_TOKEN=change-this-to-a-long-random-string

# How often to poll for pending device-user enrollment jobs (minutes).
# Punch sync is now event-driven (device push), so this only controls
# how often the enroll/remove queue on the backend is checked.
POLL_INTERVAL_MINUTES=5

# How often the agent reports its health to the HRMS backend (minutes).
# This is what makes the Developer Dashboard's "Biometric Agent" tile work —
# if heartbeats stop arriving, the dashboard shows the agent as Down.
HEARTBEAT_INTERVAL_MINUTES=2

# Stable identity for this agent install. Defaults to agent-<hostname>.
# Only needs setting if you run more than one agent (multiple offices/sites),
# so they don't overwrite each other's status row.
# AGENT_ID=agent-mainoffice
